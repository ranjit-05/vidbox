{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadVidboxVideoObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::vidbox-media-7987357f/videos/*"
    },
    {
      "Sid": "UploadVidboxVideoObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::vidbox-media-7987357f/videos/*"
    }
  ]
}
